{
  "name": "trello-clone-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + PostgreSQL REST API for the Trello clone",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "db:migrate": "psql \"$DATABASE_URL\" -f migrations/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f migrations/seed.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
